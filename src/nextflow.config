/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    xorf — single unified Nextflow configuration

    Infrastructure configuration — do not edit for normal runs.
    Scientific parameters (genome paths, alignment settings) live in params.json.

    Usage:
      nextflow run main.nf -params-file params.json -profile apptainer,slurm

    This file contains:
      1. params {}          — output dir, resource ceilings, nf-core boilerplate
      2. Process resources  — compute tiers (cpus, memory, time) via withLabel
      3. Per-step config    — container, conda, publishDir via withName
      4. Profiles           — executor and environment selection
      5. Reporting          — timeline, trace, DAG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

cleanup = false
workDir = 'work'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    MANIFEST
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/


manifest {
    name            = 'hillerlab/xorf'
    author          = 'Alejandro Gonzales-Irribarren, Michael Hiller'
    homePage        = 'https://github.com/hillerlab/xorf'
    description     = "End-to-end robust and comprehensive ORF prediction pipeline"
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.10.5'
    version         = '0.0.46'
}

validation {
    help {
        enabled = true
        command = "nextflow run main.nf -profile <docker/singularity/.../institute>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    DEFAULT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Global default params, used in configs
params {

    // Main input options
    regions       =  ''         // input directory containing fastq files
    sequence      =  ''         // path to genome fasta/2bit file
    outdir        =  null       // output directory
    env           =  null       // path to environment dir [optional]

    // Protein database options
    database             =  'https://zenodo.org/records/21399231/files/diamond_db.tar.gz?download=1' // [ default: UniProt/SwissProt pre-computed ]
    raw_database         =  'https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/complete/uniprot_sprot.fasta.gz' // [ default: UniProt/SwissProt sequences ]
    custom_database      =  ''  // [ optional; overrides database if .dmnd; if .fa, is merged with raw_database ]

    // Netstat options
    skip_netstart = true

    // Masking options
    selenocysteine_sites = null
    run_only_on = false
    run_only_mode = null // [ options: mask, unmask ]
    run_only_target = null // [ options: intersect, exclude ]

    // Chunking options
    chunk_size    = 20         // chunk size for the chunks

    // Predict options
    predict_keep_raw                  = false
    predict_min_score_max_predictions = 0.50
    predict_max_predictions           = 3
    predict_threshold                 = 0.03
    
    // Joining options
    skip_joined_concat = false // skip the joined concatenation step

    // Polishing options
    do_polishing = true // polish orfs [ truncations, duplicates ]

    // Output options
    rename_deactivate          = false
    rename_rebase              = false
    rename_append_orf_score    = true
    rename_append_protein_name = true
    rename_custom_prefix       = null

    // Weights
    samba_weights = 'https://github.com/apcamargo/RNAsamba/raw/refs/heads/master/data/full_length_weights.hdf5'
    samba_local_weights = null

    // Mailing options
    sent_email                  = false               // decides to send email or not
    smtp_server                  = 'smtp.gmail.com'  // smtp server [default: smtp.gmail.com]
    smtp_port                    = 465               // smtp port [default: 465]
    smtp_user                    = null              // smtp user [sender]
    smtp_password                = null              // smtp password [sender]
    smtp_security                = 'ssl'            // smtp security [none, tls, ssl]
    email_to                     = null              // recipient email address
    email_on_fail                = null              // email_on_fail
    plaintext_email              = false             // plaintext_email
    use_mailx                    = false             // use_mailx instead smtp

    // Boilerplate options
    publish_dir_mode             = 'copy'   // publish_dir_mode
    publish_all                  = false    // publish all
    help                         = false    // help
    help_full                    = false    // help_full
    show_hidden                  = false    // show_hidden
    version                      = false    // version
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')  // Config options

    // Config options
    config_profile_name        = null
    config_profile_description = null
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTENDING PROCESS DEFINITIONS AND ARGUMENTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Overwriting conda path for selected processes [except beaver]
process {
    if ( params.env ) {
        withName: 'XORF:.*' {
            conda = params.env
        }
    }
}

// Default publishing logic for pipeline
if ( params.publish_all ) {
    process {
        publishDir = [
            path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// Add params to concat
process {
    withName: '.*:CONCAT' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.outdir}/00_concat" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:CONCAT_RAW' {
        ext.prefix = { "${meta.id}" }
        publishDir = [
             path: { "${params.outdir}/00_concat/raw" },
             mode: params.publish_dir_mode,
             saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

process { 
  withName: '.*:RENAME_PREDICTIONS' {
        publishDir = [
            path: { "${params.outdir}/01_renamed" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args   = {
            // Standard configuration!
            def args = [ ]

            if (params.rename_rebase) {
                args += "--rebase"
            }

            if (params.rename_append_orf_score) {
                args += "--append-orf-score"
            }

            if (params.rename_append_protein_name) {
                args += "--append-protein-name"
            }

            if (params.rename_custom_prefix) {
                args += "--custom-prefix ${params.rename_custom_prefix}"
            }

            return args.join(' ')
        }
    }
}

process {
    withName: '.*:CONCAT_RENAMED' {
        publishDir = [
            path: { "${params.outdir}/02_merged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
      }

    withName: '.*:CONCAT_RENAMED_RAW' {
        publishDir = [
            path: { "${params.outdir}/02_merged/raw" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
      }
}

process {
    withName: '.*:NETSTART' {
        containerOptions = '--env HF_HUB_OFFLINE=1 --env TRANSFORMERS_OFFLINE=1 --env NETSTART2_ALLOW_HF_DOWNLOAD=0'
    }
}

process {
    withName: '.*:BLAST' {
        time   = { 2.h  * task.attempt }
    }
}

process {
    withName: '.*:PREDICT' {
        ext.when = true
        ext.min_score_max_predictions = params.predict_min_score_max_predictions
        ext.max_predictions = params.predict_max_predictions
        ext.threshold = params.predict_threshold
        ext.args   = {
            // Standard configuration!
            def base_args = []

            if (params.predict_keep_raw) {
              base_args = base_args + ' --keep-raw'
            }

            if (base_args.size() > 0) {
              return base_args.join(' ')
            } else {
              return ''
            }
        }
    }
}


// Overwriting publish mode for duplicates and final results
process {
    withName: '.*:DETACH_DUPLICATES' {
        publishDir = [
            path: { "${params.outdir}/03_duplicates" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:STRIP_TRUNCATIONS' {
        publishDir = [
            path: { "${params.outdir}/04_results" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXECUTOR/PROFILES CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

profiles {
     local {
        process.executor = 'local'
     }

     slurm {
        process {
            executor        = 'slurm'
            queue           = 'batch'
            scratch         = true
            stageInMode     = 'symlink'
            stageOutMode    = 'rsync'
            queue          = { task.time <= 24.h ? 'batch' : 'long' }
            clusterOptions = '--signal=USR2@180 --export=ALL,SLURM_SKIP_EPILOG=1'
            withName: '.*:TRANSLATION|.*:TRANSAID|.*:RNASAMBA|.*:NETSTART|.*:BLAST' {
                array = 500
            }
        }
        executor {
            queueSize         = 10000
            killBatchSize     = 1000000
            pollInterval      = '10 s'      // internal task-monitor tick (no SLURM RPC)
            queueStatInterval = '1 min'     // squeue cadence — halves RPC pressure
            submitRateLimit   = '5000/30sec' // max concurrent submits per node
            exitReadTimeout   = '5 min'    // tolerate slow .exitcode propagation; lets retry fire on ghosts
        }
    }

    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }

    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }

    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        conda.channels          = ['conda-forge', 'bioconda']
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
        docker.pullTimeout      = '20 min'
    }

    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
        includeConfig 'conf/arm.config'
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        singularity.pullTimeout = '20 min'
    }

    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        podman.pullTimeout      = '20 min'
    }

    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }

    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }

    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.pullTimeout   = '20 min'
    }

    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }

    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }

    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

    test {
        process.resourceLimits = [ cpus: 4, memory: 8.GB, time: 1.h ]

        params.regions = "${projectDir}/../assets/test_data/regions.bed"
        params.sequence = "${projectDir}/../assets/test_data/sequence.2bit"
        params.custom_database = "${projectDir}/../assets/test_data/database.dmnd.gz"
        params.selenocysteine_sites = "${projectDir}/../assets/test_data/selenocysteine_sites.bed"

        params.chunk_size = 5
        params.skip_netstart = true
        params.predict_keep_raw = true

        params.skip_joined_concat = true

        params.rename_deactivate = false
        params.rename_rebase = false
        params.rename_append_orf_score = true
        params.rename_append_protein_name = true
        params.rename_custom_prefix = null

        params.do_polishing = true

        params.outdir           = 'test_results'
        params.publish_dir_mode = 'copy'
     }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    PROCESS LABELS;
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = {
        (task.exitStatus in ((130..145) + 104 + 175)) ||
        (task.exitStatus in [null, Integer.MAX_VALUE])   ? 'retry' : 'finish'
    }
    maxRetries = 5
    maxErrors     = '-1'

    // Single processes
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Low memory processes
    withLabel:process_super_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 4     * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    // Medium memory processes
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:custom_process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 12.h   * task.attempt }
    }

    // High memory processes
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    // Long running processes
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }

    // Strategies
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    // GPU
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REGISTRY CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ENVIRONMENT CONFIG
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BASH OPTIONS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORT PARAMETER VALUES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
